#tag WindowCode
	#tag Method, Flags = &h0
		Function CreateNewDeusMaintenanceRecord() As boolean
		  dim rec as DatabaseRow
		  
		  rec = new DatabaseRow
		  rec.Column("date") = TextField1.text
		  rec.Column("inspector") = TextField2.text
		  rec.Column("unitname") = TextField3.text
		  if PopupMenu1.SelectedRowIndex <> -1 then
		    rec.Column("eventtype") = PopupMenu1.RowTextAt(PopupMenu1.SelectedRowIndex)
		  end if
		  rec.column("eulerleft") = TextField5.text
		  rec.Column("eulerright") = TextField6.text
		  rec.column("cleanliness") = TextField7.text
		  rec.column("notes") = TextArea1.text
		  Try
		    mysqldb.AddRow("deusmaintenance",rec)
		    return true
		  catch err as DatabaseException
		    
		  end try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToCreateNew()
		  
		  TextField1.ReadOnly = false
		  TextField2.ReadOnly = false
		  TextField3.ReadOnly = false
		  PopupMenu1.enabled = true
		  TextField5.ReadOnly = false
		  TextField6.ReadOnly = false
		  TextArea1.ReadOnly = false
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToReadOnly()
		  
		  TextField1.ReadOnly = true
		  TextField2.ReadOnly = true
		  TextField3.ReadOnly = true
		  'PopupMenu1.enabled = false
		  TextField5.ReadOnly = true
		  TextField6.ReadOnly = true
		  TextArea1.ReadOnly = true
		  
		  button1.Caption = "Close"
		  button2.Visible = false
		  Canvas1.Visible = false
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub ShowGivenRecord(inserial as string)
		  dim rs as rowset
		  
		  SetWindowToReadOnly
		  Try
		    rs = mysqldb.SelectSQL("SELECT * from deusmaintenance where serial = '" + inserial + "'")
		    if rs <> nil then
		      if not rs.AfterLastRow then
		        TextField1.text = rs.Column("date").StringValue
		        TextField2.text = rs.Column("inspector").StringValue
		        TextField3.text = rs.Column("unitname").StringValue
		        '-----
		        popupmenu1.RemoveAllRows
		        PopupMenu1.addrow rs.Column("eventtype").StringValue
		        PopupMenu1.SelectedRowIndex = PopupMenu1.RowCount - 1
		        '-----
		        TextField5.text = rs.column("eulerleft").StringValue
		        TextField6.text = rs.Column("eulerright").StringValue
		        TextField7.text = rs.Column("cleanliness").StringValue
		        TextArea1.text = rs.column("notes").StringValue
		      end if
		    end if
		    
		    
		  catch err as DatabaseException
		    
		  end try
		  
		  Label8.text = "Maintenance Event Detail"
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events Button1
	#tag Event
		Sub Pressed()
		  
		  
		  
		  if me.Caption = "Save" then
		    if CreateNewDeusMaintenanceRecord then
		      self.close
		      window1.LoadDeusMaintenance
		    end if
		  elseif me.caption = "Close" then
		    self.close
		  end if
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button2
	#tag Event
		Sub Pressed()
		  self.close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Canvas1
	#tag Event
		Sub DateSelected(Month as integer,Day as integer,Year as integer)
		  'setthe datefield
		  
		  TextField1.text = format(year,"0000") + format(month,"00") + format(day,"00")
		End Sub
	#tag EndEvent
#tag EndEvents
