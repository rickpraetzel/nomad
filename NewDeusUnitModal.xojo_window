#tag EndDesktopWindow

#tag WindowCode
	#tag Method, Flags = &h0
		Function CreateNewDeusUnit() As boolean
		  dim rec as DatabaseRow
		  
		  rec = new DatabaseRow
		  rec.Column("date") = TextField1.text
		  rec.Column("name") = TextField2.text
		  rec.Column("modelnumber") = TextField3.text
		  rec.Column("serialnumber") = TextField4.text
		  rec.column("datelastinsepcted") = TextField5.text
		  rec.Column("datelastcertified") = TextField6.text
		  rec.column("eulerleft") = TextField7.text
		  rec.Column("eulerright") = TextField8.text
		  rec.column("notes") = TextArea1.text
		  
		  Try
		    mysqldb.AddRow("deusunits",rec)
		    return true
		  catch err as DatabaseException
		    
		  end try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToCreateNew()
		  TextField1.readonly = false
		  TextField2.readonly = false
		  TextField3.readonly = false
		  TextField4.readonly = false
		  TextField5.readonly = false
		  TextField6.readonly = false
		  TextArea1.readonly = false
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToReadOnly()
		  TextField1.readonly = true
		  TextField2.readonly = true
		  TextField3.readonly = true
		  TextField4.readonly = true
		  TextField5.readonly = true
		  TextField6.readonly = true
		  TextArea1.readonly = true
		  
		  Button1.Caption = "Close"
		  Button2.Visible = false
		  
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub ShowGivenRecord(inserial as string)
		  
		  
		  SetWindowToReadOnly
		  
		  dim rs as rowset
		  
		  Try
		    rs = mysqldb.SelectSQL("Select * from deusunits where serial = '" + inserial + "'")
		    if rs <> nil then
		      if not rs.afterlastrow then
		        TextField1.text = rs.Column("date").StringValue
		        TextField2.text = rs.Column("name").StringValue
		        TextField3.text = rs.Column("modelnumber").StringValue
		        TextField4.text = rs.Column("serialnumber").StringValue
		        TextField5.text = rs.column("datelastinspected").StringValue
		        TextField6.text = rs.Column("datelastcertified").StringValue
		        TextField7.text = rs.Column("eulerleft").StringValue
		        TextField8.text = rs.Column("eulerright").StringValue
		        TextArea1.text = rs.column("notes").StringValue
		      end if
		    end if
		  catch err as DatabaseException
		    
		  end try
		  
		  Label8.text = "Deus Detail"
		  
		  
		  
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events Button1
	#tag Event
		Sub Pressed()
		  
		  if me.Caption = "Save" then
		    if CreateNewDeusUnit then
		      self.close
		      window1.LoadAppliances
		    end if
		  elseif me.caption = "Close" then
		    self.close
		  end if
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button2
	#tag Event
		Sub Pressed()
		  self.close
		End Sub
	#tag EndEvent
#tag EndEvents
