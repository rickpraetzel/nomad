		  elseif TabPanel1.SelectedPanelIndex = 1then
		    NewDeusMainenanceEventModal.ShowModal(self)
		  elseif TabPanel1.SelectedPanelIndex = 2 then
		    NewVFInspectionEventModal.ShowModal(self)
