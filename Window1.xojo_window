	#tag Event
		Sub Opening()
		  if Createdatabase then
		    if tabpanel1.SelectedPanelIndex = 0 then
		      LoadDeusUse
		    elseif tabpanel1.SelectedPanelIndex = 1 then
		      LoadDeusMaintenance
		    elseif tabpanel1.SelectedPanelIndex = 2 then
		      LoadInspections
		    elseif tabpanel1.SelectedPanelIndex = 3 then
		      LoadAppliances
		    end if
		  else
		  end if
		End Sub
	#tag EndEvent


	#tag Method, Flags = &h0
		Function CalculateJoulesSinceLastCertification(deusserial as string) As integer
		  '85 x 23 x 10 x drops
		  
		  'get last certification
		  
		  dim sqlstring as string
		  dim rs as rowset
		  dim n as integer
		  
		  sqlstring = "SELECT SUM(dropcount + staff) from deususe where date > (select datelastcertified from deusunits where serial = '" + deusserial + "') AND deusserial = '" + deusserial + "'"
		  
		  Try
		    rs = mysqldb.SelectSQL(sqlstring)
		    if rs <> nil then
		      if not rs.AfterLastRow then
		        n = rs.ColumnAt(0).IntegerValue
		        if n <> 0 then
		          n = n*85*23*10
		          'store this calculation
		          Try
		            mysqldb.ExecuteSQL("UPDATE deusunits SET joulessincelastcert = " + str(n) + " WHERE serial = '" + deusserial + "'")
		          catch err1 as DatabaseException
		            
		          end Try
		          return n
		        end if
		      end if
		    end if
		  catch err as DatabaseException
		    
		  end try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Function CalculateJoulesSinceLastInspection(deusserial as string) As integer
		  '85 x 23 x 10 x drops
		  
		  'get last certification
		  
		  dim sqlstring as string
		  dim rs as rowset
		  dim n as integer
		  
		  sqlstring = "SELECT SUM(dropcount + staff) from deususe where date > (select datelastinspected from deusunits where serial = '" + deusserial + "') AND deusserial = '" + deusserial + "'"
		  
		  Try
		    rs = mysqldb.SelectSQL(sqlstring)
		    if rs <> nil then
		      if not rs.AfterLastRow then
		        n = rs.ColumnAt(0).IntegerValue
		        if n <> 0 then
		          n = n*85*23*10
		          'store this calculation
		          Try
		            mysqldb.ExecuteSQL("UPDATE deusunits SET joulessincelastinspect = " + str(n) + " WHERE serial = '" + deusserial + "'")
		          catch err1 as DatabaseException
		            
		          end Try
		          return n
		        end if
		      end if
		    end if
		  catch err as DatabaseException
		    
		  end try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Function Createdatabase() As boolean
		  dim stream as textinputStream
		  dim f,g as folderitem
		  dim s as string
		  
		  'f = getfolderItem("")
		  'g = f.child("Misc").child("hosting.txt")
		  'if g <> nil and g.exists then
		  'stream = g.openastextFile
		  dbusername = "manuser"
		  dbpassword = "u53rm4n"
		  dbhost = "192.168.0.102"
		  dbname = "ZacReg"
		  dbport = 3306
		  dbtestname = "ZacTest"
		  dbtimeout = 0
		  'stream.close()
		  
		  mysqldb = new MySQLCommunityServer()
		  mysqldb.Host = dbhost
		  mysqldb.UserName = dbusername
		  mysqldb.Password = dbpassword
		  mysqldb.Port = dbport
		  if not DebugBuild then 
		    mysqldb.DatabaseName = dbname
		    operations = app.kNormalMode
		    
		  else
		    mysqldb.DatabaseName = dbtestname
		    operations = app.kTestMode
		    
		  end if
		  
		  try
		    mysqldb.Connect()
		    return true
		  catch error as DatabaseException
		    MessageBox error.Message
		  end try
		  
		  'else
		  'return false
		  '
		  'end if
		  
		  exception err
		    if err isa nilObjectException then
		      msgbox "Createdatabase Nil Object"
		    elseif err isa outofboundsException then
		      msgbox "Createdatabase Out Of Bounds"
		    elseif err isa typeMismatchException then
		      msgbox "Createdatabase Type Mismatch"
		    elseif err isa IllegalCastException then
		      msgbox "Createdatabase Illegal Cast"
		    end if
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub LoadAppliances()
		  dim rs as RowSet
		  dim sqlstring as string
		  
		  listbox4.RemoveAllRows
		  
		  sqlstring = "Select * from deusunits ORDER by date DESC"
		  
		  Try
		    rs = mysqldb.SelectSQL(sqlstring)
		    if rs <> nil then
		      if not rs.AfterLastRow then
		        while not rs.AfterLastRow
		          listbox4.addrow rs.columnat(1).StringValue,rs.columnat(2).StringValue,rs.columnat(3).StringValue,rs.columnat(4).StringValue,rs.columnat(5).StringValue,rs.columnat(6).StringValue,rs.columnat(7).StringValue,rs.columnat(8).StringValue
		          listbox4.CellTextAt(listbox4.rowcount - 1,8) = format(CalculateJoulesSinceLastCertification( rs.ColumnAt(0).StringValue),"###,###,##0.00")
		          listbox4.CellTextAt(listbox4.rowcount - 1,9) = format(CalculateJoulesSinceLastInspection( rs.ColumnAt(0).StringValue),"###,###,##0.00")
		          
		          listbox4.CellTagAt(listbox4.rowcount - 1,0) = rs.ColumnAt(0).StringValue 'this loads the record serial in the first column celltag
		          rs.MoveToNextRow
		        wend
		      end if
		    end if
		  catch err as DatabaseException
		    
		  end try
		End Sub
	#tag EndMethod

