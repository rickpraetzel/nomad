#tag WindowCode
	#tag Method, Flags = &h0
		Sub CalculateRemainingDrops()
		  
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Function CreateNewDeusUseRecord() As boolean
		  dim rec as DatabaseRow
		  dim i,n,remainingdrops,ser as integer
		  dim currentdeus as DeusClass
		  
		  rec = new DatabaseRow
		  rec.Column("date") = TextField1.text
		  rec.Column("org") = TextField2.text
		  rec.Column("dropcount") = TextField3.text
		  rec.Column("staff") = TextField4.text
		  rec.column("height") = TextField5.text
		  rec.Column("location") = TextField6.text
		  rec.column("notes") = TextArea1.text
		  n = val(TextField3.text) + val(TextField4.text) 'total drops on this event
		  rec.Column("joulesabsorbed") = str(n * 85 * 20* 10) '200 lbs x 65 ft x gravity
		  
		  Try
		    mysqldb.AddRow("deususe",rec)
		    ser = mysqldb.lastinsertedrowid
		    '----- Get total joules since last certification and subtract from 200 M then divide by 17000
		    n = window1.CalculateJoulesSinceLastCertification("1000")
		    if n <> 0 then
		      '----- Get the deus defaults
		      if ubound(deuslist) >= 0 then
		        for i = 0 to ubound(deuslist)
		          if deuslist(i).serial = "1000" then
		            currentdeus = deuslist(i)
		            exit
		          end if
		        next
		      end if
		      '-----
		      remainingdrops = (200000000 - n)/(currentdeus.defaultweight * currentdeus.defaultdrop * 10)
		      if remainingdrops <> 0 then
		        Try
		          mysqldb.ExecuteSQL("UPDATE deususe SET dropsremaining = '" + str(remainingdrops) + "' where serial = '" + str(ser)+ "'")
		          'add this to the listbox info
		          
		        catch err as DatabaseException
		          
		        end try
		      end if
		    end if
		    '-----
		    return true
		  catch err as DatabaseException
		    
		  end try
		End Function
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToCreateNew()
		  TextField1.readonly = false
		  TextField2.readonly = false
		  TextField3.readonly = false
		  TextField4.readonly = false
		  TextField5.readonly = false
		  TextField6.readonly = false
		  TextArea1.readonly = false
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub SetWindowToReadOnly()
		  TextField1.readonly = true
		  TextField2.readonly = true
		  TextField3.readonly = true
		  TextField4.readonly = true
		  TextField5.readonly = true
		  TextField6.readonly = true
		  TextArea1.readonly = true
		  
		  Button1.Caption = "Close"
		  Button2.Visible = false
		  
		  Canvas1.Visible = false
		End Sub
	#tag EndMethod

	#tag Method, Flags = &h0
		Sub ShowGivenRecord(inserial as string)
		  
		  
		  SetWindowToReadOnly
		  
		  dim rs as rowset
		  
		  Try
		    rs = mysqldb.SelectSQL("Select * from deususe where serial = '" + inserial + "'")
		    if rs <> nil then
		      if not rs.afterlastrow then
		        TextField1.text = rs.Column("date").StringValue
		        TextField2.text = rs.Column("org").StringValue
		        TextField3.text = rs.Column("dropcount").StringValue
		        TextField4.text = rs.Column("staff").StringValue
		        TextField5.text = rs.column("height").StringValue
		        TextField6.text = rs.Column("location").StringValue
		        TextArea1.text = rs.column("notes").StringValue
		      end if
		    end if
		  catch err as DatabaseException
		    
		  end try
		  
		  Label8.text = "Deus " + rs.column("deusserial").stringvalue + " Use Event Detail"
		  
		  
		  
		End Sub
	#tag EndMethod


#tag EndWindowCode

#tag Events Button1
	#tag Event
		Sub Pressed()
		  
		  if me.Caption = "Save" then
		    if CreateNewDeusUseRecord then
		      self.close
		      window1.LoadDeusUse
		    end if
		  elseif me.caption = "Close" then
		    self.close
		  end if
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Button2
	#tag Event
		Sub Pressed()
		  self.close
		End Sub
	#tag EndEvent
#tag EndEvents
#tag Events Canvas1
	#tag Event
		Sub DateSelected(Month as integer,Day as integer,Year as integer)
		  'setthe datefield
		  
		  TextField1.text = format(year,"0000") + format(month,"00") + format(day,"00")
		End Sub
	#tag EndEvent
#tag EndEvents
